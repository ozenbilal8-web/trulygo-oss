# Start the isolated stack, then run node scripts/setup-local.mjs.
# It writes local credentials to ignored .env.local without printing them.
# No hosted project, production account or external email provider is needed.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:58421
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required for authentication rate limits and trusted creation; server-only.
# Never prefix this credential with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Required with the complete migration chain.
TRULYGO_TRUSTED_LINK_CREATE_V2=true
# Use a random value; generated for local development by setup-local.mjs.
CLICK_VISITOR_HASH_SECRET=

# Optional external integrations. Leave empty for local manual approval.
# With no Web Risk key, links require administrator review.
GOOGLE_WEB_RISK_API_KEY=
RESEND_API_KEY=
RESEND_FROM=
# Optional instance branding/contact configuration. Use your own public contacts.
SUPPORT_EMAIL=
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_ENABLE_ANALYTICS=false
