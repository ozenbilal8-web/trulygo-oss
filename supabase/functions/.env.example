# Optional isolated Edge Function configuration. Never commit real values.
# Supabase supplies runtime credentials for hosted workers; local emulation
# must use only the dedicated local backend values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Match Vault's link_request_auto_approve_webhook_secret in the same instance.
LINK_REQUEST_AUTO_APPROVE_WEBHOOK_SECRET=
# Dedicated reviewer Auth UUID in the same isolated backend.
LINK_REQUEST_AUTO_APPROVER_USER_ID=
# Fresh fully migrated instances require trusted clean server attestation.
REQUIRE_LINK_SAFETY_ATTESTATION=true
