{
  "name": "trulygo-oss",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hostable reviewed link management, analytics, profiles and surveys.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozenbilal8-web/trulygo-oss.git"
  },
  "bugs": {
    "url": "https://github.com/ozenbilal8-web/trulygo-oss/issues"
  },
  "homepage": "https://github.com/ozenbilal8-web/trulygo-oss#readme",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --audit-level=moderate",
    "test:admin": "node --test tests/admin-panel.test.mjs",
    "test:auth-response": "node --test tests/supabase-auth-response-headers.test.mjs",
    "test:email": "node --test tests/transactional-email-templates.test.mjs",
    "test:favicon": "node --test tests/favicon-assets.test.mjs",
    "test:legal": "node --test tests/legal-compliance.test.mjs",
    "lint": "eslint",
    "test:click-events": "node --test tests/click-event-utm.test.mjs",
    "test:link-vitrine": "node --test tests/link-vitrine-profile-views.test.mjs tests/link-vitrine-profile-view-security.test.mjs tests/link-vitrine-collaboration.test.mjs",
    "test:seo": "node --test tests/link-vitrine-indexability.test.mjs tests/link-vitrine-identity.test.mjs tests/link-vitrine-seo.test.mjs tests/public-route-reservations.test.mjs tests/seo-landing-foundation.test.mjs tests/seo-core-intent-pages.test.mjs tests/seo-vitrine-signal-pages.test.mjs tests/guides.test.mjs",
    "test:slugs": "node --test tests/public-route-reservations.test.mjs",
    "test:utm": "node --test tests/utm-builder.test.mjs tests/public-utm-draft.test.mjs",
    "test:web-risk": "node --test tests/web-risk.test.mjs",
    "licenses": "node scripts/check-licenses.mjs",
    "test:e2e": "playwright test",
    "local:env": "node scripts/setup-local.mjs",
    "test:local": "node scripts/test-local.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
