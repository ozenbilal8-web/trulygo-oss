    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "supabase": "2.98.2",
    "tailwindcss": "4.3.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.23",
    "exceljs": {
      "uuid": "11.1.1",
